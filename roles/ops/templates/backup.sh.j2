#!/bin/bash

# Database Backup Script
# Generated by Ansible

BACKUP_DIR="{{ backup.backup_dir }}"
RETENTION_DAYS={{ backup.retention_days }}
DATE=$(date +%Y%m%d_%H%M%S)

# Create backup directory for today
mkdir -p $BACKUP_DIR/$DATE

# Backup MySQL databases
{% for server in backup.servers %}
echo "Backing up {{ server.name }} ({{ server.host }})..."
{% for db in server.databases %}
mysqldump -h {{ server.host }} -u {{ server.user }} -pSecureRootPass123! {{ db }} > $BACKUP_DIR/$DATE/{{ server.name }}_{{ db }}.sql 2>/dev/null
{% endfor %}
{% endfor %}

# Compress backups
cd $BACKUP_DIR
tar -czf backup_$DATE.tar.gz $DATE/
rm -rf $DATE/

# Remove old backups
find $BACKUP_DIR -name "backup_*.tar.gz" -mtime +$RETENTION_DAYS -delete

echo "Backup completed: backup_$DATE.tar.gz"
