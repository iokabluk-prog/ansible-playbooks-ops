server {
    listen 80;
    server_name {{ nginx.server_name }};

    # Grafana
    location / {
        proxy_pass http://localhost:{{ monitoring.grafana.port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Prometheus
    location /prometheus/ {
        proxy_pass http://localhost:{{ monitoring.prometheus.port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Alertmanager
    location /alertmanager/ {
        proxy_pass http://localhost:{{ monitoring.alertmanager.port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Loki
    location /loki/ {
        proxy_pass http://localhost:{{ monitoring.loki.port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
